# Copiar a .env y cambiar los valores:  cp .env.example .env
# El .env no se sube al repositorio (.gitignore).

# Identidad
IDENTITY_DB_PASSWORD=cambiar-esta-clave

# Inventario
INVENTORY_DB_PASSWORD=cambiar-esta-clave

# Ventas
SALES_DB_PASSWORD=cambiar-esta-clave
# Perfil demo usa datos de reserva simulados; usa otro perfil para consultar Inventario.
SALES_PROFILE=demo
