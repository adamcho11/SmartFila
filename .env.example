# Copiar a .env y cambiar los valores:  cp .env.example .env
# El .env no se sube al repositorio (.gitignore).

# Identidad
IDENTITY_DB_PASSWORD=cambiar-esta-clave

# Inventario
INVENTORY_DB_PASSWORD=cambiar-esta-clave

# Ventas
SALES_DB_PASSWORD=cambiar-esta-clave
# Perfil demo usa datos de reserva simulados; usa otro perfil para consultar Inventario.
SALES_PROFILE=demo
SMARTFILA_PUBLIC_BASE_URL=http://localhost:8084
# Opcional: habilitar envio de trazas OTLP al collector indicado.
SMARTFILA_OTEL_ENABLED=false
SMARTFILA_TRACING_SAMPLING=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://host.docker.internal:4318/v1/metrics
